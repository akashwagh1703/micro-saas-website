# Don't cache index.html — after each deploy Vite generates new hashed asset names.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed assets are safe to cache forever (filename changes every build).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/portal/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
